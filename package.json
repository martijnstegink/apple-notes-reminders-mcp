{
  "name": "apple-notes-reminders-mcp",
  "version": "1.0.0",
  "description": "MCP server for Apple Notes and Reminders",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:swift": "swiftc swift/reminders-daemon.swift -o swift/reminders-daemon",
    "postinstall": "npm run build:swift",
    "start": "node dist/index.js",
    "test": "npm run build && node scripts/test-markdown.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.11.1",
    "chrono-node": "^2.7.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
